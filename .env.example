# Copiar a .env para desarrollo local. NUNCA commitear .env con valores reales.
APP_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=replace-with-a-long-random-secret

# Vacío = SQLite local en instance/dev.sqlite3. En Railway: ${{Postgres.DATABASE_URL}}
# (postgres:// y postgresql:// se convierten solos a postgresql+psycopg://)
DATABASE_URL=

EVENT_CODE=AMVEPE2026
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

ADMIN_USERNAME=admin
# Generar con: flask hash-password
ADMIN_PASSWORD_HASH=

PUBLIC_DEMO_URL=https://example.com/perseo-pets-demo

# Solo para importar contenido (flask import-pexels). Clave gratuita en https://www.pexels.com/api/
PEXELS_API_KEY=
# Magnific (antes Freepik): requiere plan con acceso a API. Cada descarga consume créditos.
MAGNIFIC_API_KEY=

# Opcionales
# MAX_SESSIONS_PER_PARTICIPANT=0        # 0 = sin límite
# ACTION_GRACE_SECONDS=0.75             # tolerancia de red en los límites de etapa
# BREED_QUESTIONS_PER_SESSION=24
# ALLOW_PLACEHOLDER_ASSETS=false        # imágenes de prueba (solo desarrollo)
# RATELIMIT_STORAGE_URI=memory://
