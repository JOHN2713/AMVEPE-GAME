{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/vercel_build.py",
  "functions": {
    "wsgi.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
